<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="assets_backend_refrigerator" inherit_id="website.layout">
        <xpath expr="//body" position="inside">
            <t t-if="not user_id._is_public()">
                <div id="refrigerator_reminder_popup" class="o_dialog_container" style="position: fixed; z-index: 9999; top: 0; left: 0; width: 100%; height: 100%;">
                    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background: rgba(0,0,0,0.6);">
                        <div class="modal-dialog modal-dialog-centered" role="document">
                            <div class="modal-content border-0 shadow-lg">
                                <div class="modal-header px-3">
                                    <h5 class="modal-title">Recordatorio</h5>
                                </div>
                                <div class="modal-body">
                                    <p class="font-weight-bold" style="font-size: 16px; color: #333; margin-bottom: 0;">
                                    Recuerden que deben retirar todas sus pertenencias de las neveras compartidas
                                        <strong>antes de las 2:30 p.m.</strong>
                                    </p>
                                </div>
                                <div class="modal-footer justify-content-center">
                                    <button id="btn_read_refrigerator" class="accept-button">Leído</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>