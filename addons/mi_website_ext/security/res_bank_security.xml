<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_employee_form_bank_custom_fields_final" model="ir.ui.view">
            <field name="name">hr.employee.form.bank.custom.fields.final</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                
                <xpath expr="//field[@name='bank_account_id']" position="replace">
                    <field name="x_bank_name" placeholder="Ej: Banco General, Banistmo..."/>
                    <field name="x_bank_account_num" placeholder="Ej: 04-38-98-799731-6"/>
                </xpath>

            </field>
        </record>

        <record id="res_users_view_form_profile_custom_bank" model="ir.ui.view">
            <field name="name">res.users.preferences.form.custom.bank</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="hr.res_users_view_form_profile"/>
            <field name="arch" type="xml">
                
                <xpath expr="//field[@name='employee_bank_account_id']" position="replace">
                    <field name="x_bank_name" placeholder="Ej: Banco General, Banistmo..."/>
                    <field name="x_bank_account_num" placeholder="Ej: 04-38-98-799731-6"/>
                </xpath>

            </field>
        </record>
    </data>
</odoo>